#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	echo "=== [BUILD] Начало сборки ==="
	echo "=== [BUILD] Текущая директория: $$(pwd) ==="
	echo "=== [BUILD] Скачиваем .deb ==="
	wget -O $(CURDIR)/Formato_1.0.0_amd64.deb https://github.com/App-Lab-Hub/formato/releases/download/1.0.0/Formato_1.0.0_amd64.deb
	echo "=== [BUILD] Проверяем, что файл скачан ==="
	ls -la $(CURDIR)/Formato_1.0.0_amd64.deb
	echo "=== [BUILD] Распаковываем .deb во временную папку ==="
	mkdir -p $(CURDIR)/debian/extracted
	dpkg-deb -x $(CURDIR)/Formato_1.0.0_amd64.deb $(CURDIR)/debian/extracted/
	echo "=== [BUILD] Что лежит в debian/extracted/ ==="
	find $(CURDIR)/debian/extracted -type f | head -30

override_dh_auto_install:
	echo "=== [INSTALL] Начало установки ==="
	mkdir -p $(CURDIR)/debian/formato-bin
	cp -a $(CURDIR)/debian/extracted/* $(CURDIR)/debian/formato-bin/
	install -Dm644 $(CURDIR)/debian/formato.1 $(CURDIR)/debian/formato-bin/usr/share/man/man1/formato.1
	echo "=== [INSTALL] Что лежит в debian/formato-bin/ ==="
	find $(CURDIR)/debian/formato-bin -type f | head -30

override_dh_strip:
	dh_strip --no-automatic-dbgsym

override_dh_dwz:
	# Отключаем dwz (нет debug info)

override_dh_makeshlibs:
	# Отключаем makeshlibs (Rust бинарник не предоставляет shared libraries)

override_dh_shlibdeps:
	# Отключаем shlibdeps (Rust статически линкует всё)
