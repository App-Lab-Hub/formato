{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Formato",
  "version": "1.0.0",
  "identifier": "com.app-lab-hab.formato",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Formato",
        "maximized": true,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "decorations": true,
        "center": true,
        "visible": false,
        "dragDropEnabled": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: ipc://* http://ipc.localhost; img-src 'self' asset: https: http: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' blob:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "category": "Utility",
    "externalBin": ["bin/ffmpeg", "bin/ffprobe"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
