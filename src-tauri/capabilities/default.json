{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the windows",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/.local/share/formato/converted/*"
        },
        {
          "path": "$HOME/.cache/formato/*"
        }
      ]
    }
  ]
}
