{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the windows",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "fs:allow-write-file",
    "fs:allow-download-write",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPLOCALDATA/**/*"
        },
        {
          "path": "$APPCACHE/*"
        },
        {
          "path": "$APPROAMINGDATA/*"
        }
      ]
    }
  ]
}
