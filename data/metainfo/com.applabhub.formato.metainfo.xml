<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
    <id>com.applabhub.formato</id>
    <name>Formato</name>
    <summary>Universal data converter for 60+ formats</summary>
    <metadata_license>MIT</metadata_license>
    <project_license>MIT</project_license>
    
    <developer id="io.github.applabhub">
        <name>App Lab Hub</name>
    </developer>

    <description>
        <p>Formato is a powerful, open-source universal data converter designed for speed and privacy. It supports over 60 formats, including JSON, YAML, XML, CSV, TOML, INI, Markdown, HTML, DOCX, ODT, XLSX, PDF, images, audio, and video. All data is processed locally on your device — no uploads, no limits.</p>
        <p>Whether you're a developer, analyst, or just someone who works with data daily, Formato adapts to your needs with a clean, modern interface and powerful conversion capabilities.</p>
        <p>Key features include:</p>
        <ul>
            <li>Convert between 60+ formats (text, documents, images, audio, video)</li>
            <li>Speech synthesis (TTS) with Russian and English voices</li>
            <li>Speech recognition (STT) using Whisper models</li>
            <li>Built-in file manager with history, search, and reset options</li>
            <li>Dark / Light / System theme support</li>
            <li>Russian and English interface</li>
            <li>100% local processing — nothing is sent to the internet</li>
            <li>File archiving (ZIP, TAR.GZ, TAR.XZ)</li>
            <li>Conversion caching for lightning-fast repeated conversions</li>
        </ul>
    </description>

    <categories>
        <category>Utility</category>
        <category>FileTools</category>
    </categories>

