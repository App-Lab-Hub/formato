{
  "name": "formato",
  "version": "1.0.0",
  "description": "Modern universal data converter for 60+ formats — JSON, YAML, XML, CSV, images, audio, video and more. Features speech synthesis, speech recognition, and a beautiful modern UI. Built with Rust + Svelte + Tauri. 100% local, no uploads, no limits.",
  "type": "module",
  "scripts": {
    "copy-deps": "cp package.json static/ && cp src-tauri/Cargo.toml static/",
    "predev": "npm run copy-deps",
    "prebuild": "npm run copy-deps",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:run": "vitest run"
  },
  "license": "MIT",
  "author": "app-lab-hub",
  "repository": {
    "type": "git",
    "url": "https://github.com/App-Lab-Hub/formato"
  },
  "keywords": [
    "converter",
    "data-converter",
    "file-converter",
    "media-converter",
    "json",
    "yaml",
    "xml",
    "csv",
    "toml",
    "markdown",
    "html",
    "image-converter",
    "audio-converter",
    "video-converter",
    "document-converter",
    "pdf",
    "docx",
    "odt",
    "xlsx",
    "speech-synthesis",
    "text-to-speech",
    "speech-recognition",
    "whisper",
    "tts",
    "stt",
    "rust",
    "svelte",
    "tauri",
    "desktop-app",
    "gui",
    "modern-ui",
    "dark-mode",
    "tailwindcss",
    "offline",
    "local-processing",
    "privacy-first",
    "open-source",
    "cross-platform",
    "windows",
    "macos",
    "linux",
    "no-cloud"
  ],
  "bugs": {
      "url": "https://github.com/App-Lab-Hub/formato/issues"
  },
  "homepage": "https://github.com/App-Lab-Hub/formato#readme",
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@melt-ui/svelte": "^0.86.6",
    "@motionone/dom": "^10.18.0",
    "@splidejs/splide": "^4.1.4",
    "@splidejs/svelte-splide": "^0.2.9",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-svelte": "^1.0.1",
    "overlayscrollbars": "^2.16.0",
    "svelte-icons": "^2.1.0",
    "tailwindcss": "^4.3.0",
    "toastify-js": "^1.12.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@inlang/paraglide-js": "^2.18.2",
    "@internationalized/date": "^3.12.1",
    "@lucide/svelte": "^1.3.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^25.9.1",
    "@types/toastify-js": "^1.12.4",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "shadcn-svelte": "^1.2.7",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
